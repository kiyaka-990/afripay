# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://dashboard.afripay.dev

# ─── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────────
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_CALLBACK_URL=https://api.afripay.dev/v1/webhooks/mpesa

# ─── MTN MoMo ─────────────────────────────────────────────────────────────────
MTN_MOMO_ENV=sandbox                   # sandbox | production
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key
MTN_MOMO_API_USER=your_api_user_uuid
MTN_MOMO_API_KEY=your_api_key
MTN_MOMO_CALLBACK_URL=https://api.afripay.dev/v1/webhooks/mtn

# ─── Airtel Money ─────────────────────────────────────────────────────────────
AIRTEL_ENV=sandbox                     # sandbox | production
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret
AIRTEL_CALLBACK_URL=https://api.afripay.dev/v1/webhooks/airtel

# ─── Redis (optional — falls back to in-memory) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Key Signing ──────────────────────────────────────────────────────────
API_KEY_SECRET=change_this_to_a_long_random_secret_min_32_chars

# ─── Rate Limits (requests / 15 min) ─────────────────────────────────────────
RATE_LIMIT_FREE=100
RATE_LIMIT_STARTER=500
RATE_LIMIT_PRO=2000
RATE_LIMIT_ULTRA=10000

# ─── Snipe Payment ────────────────────────────────────────────────────────────
SNIPE_ENV=sandbox                      # sandbox | production
SNIPE_CLIENT_ID=your_snipe_client_id
SNIPE_CLIENT_SECRET=your_snipe_client_secret
SNIPE_PUBLIC_KEY=your_snipe_public_key
SNIPE_CALLBACK_URL=https://api.afripay.dev/v1/webhooks/snipe

# ─── Stripe Billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Stripe Price IDs (create in Stripe dashboard → Products)
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ULTRA=price_ultra_monthly
